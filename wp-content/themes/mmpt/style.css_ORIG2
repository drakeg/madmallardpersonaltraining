/*
 * Theme name: MM Personal Training
 * Text Domain: Mad Mallard Personal Training
 * Version: 0.1
 * Description: Fancy top menu bar dark theme
 * Tags: responsive, bootstrap, fancy, top-menu
 * Author: Greg Drake
 * Author URI: http://www.madmallardpersonaltraining.com
 * */
@viewport {
    width: device-width;
}
@-ms-viewport {
    width: device-width;
}
* {
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    -box-sizing: border-box;
}
body {
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 0px;
    background-color: #000;
    color: gray;
    line-height: 2.4rem;
}
p {
    font-family: 'Nunito', sans-serif;
    font-size: 16px;
    color:white;
    line-height: 28px;
}
.header {
    overflow: hidden;
    background-color: #000;
    padding: 20px 10px;
}
.header a.logo {
    font-size: 25px;
    font-weight: bold;
    float: left;
    color: white;
    text-align: center;
    padding: 12px;
    text-decoration: none;
    font-size: 28px;
    line-height: 25px;
}
.header-right {
    float: right;
}
.header ul.menu {
    list-style-type: none;
}
.header ul.menu li {
    display: inline;
}
.header ul.menu li a {
    float: left;
    color: white;
    text-align: center;
    padding: 12px;
    text-decoration: none;
    font-size: 18px;
    line-height: 25px;
    border-radius: 4px;
}
.header ul.menu li a:hover {
    background-color: #ddd;
    color: black;
}

@media screen and (max-width: 500px) {
    .header a {
        float: none;
        display: block;
        text-align: left;
    }
    .header-right {
        float: none;
    }
}
.content {
    padding: 0px 20px;
}
.footer .copyright {
    padding: 28px 0;
    margin-top: 55px;
    background-color: #000;
}
.footer .copyright span {
    float: left;
}
.footer .copyright span,
.footer .copyright a {
    color: #878787;
    -webkit-transition: all 0.3s linear;
    -o-transition: all 0.3s linear;
    transition: all 0.3s linear;
}
.footer .copyright a:hover {
    color:#007bff;
}
.footer .copyright-menu {
    float: right;
}
.footer ul.menu {
    list-style-type: none;
}
.footer ul.menu li {
    display: inline;
}
.footer ul.menu li a {
    float: right;
    color: white;
    text-align: center;
    text-decoration: none;
    padding: 10px;
}
.footer ul.menu li a:hover {
    color: gray;
}
.footer .back-to-top {
  position: relative;
  z-index: 2;
}
.footer .back-to-top .btn-dark {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    padding: 0;
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #2e2e2e;
    border-color: #2e2e2e;
    display: none;
    z-index: 999;
    -webkit-transition: all 0.3s linear;
    -o-transition: all 0.3s linear;
    transition: all 0.3s linear;
}
.footer .back-to-top .btn-dark:hover {
    cursor: pointer;
    background: #FA6742;
    border-color: #FA6742;
}
